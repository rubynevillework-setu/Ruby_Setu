# Postgres (Neon, EU region - Frankfurt). Not required until phase 2.
DATABASE_URL=

# Transactional email for introduction requests. Without it, requests are logged to the server console.
RESEND_API_KEY=
INTRO_NOTIFY_EMAIL=
# Optional. Defaults to Resend's shared sender, which works before you own a
# verified domain. Set this once rubysetu.org is verified with Resend.
INTRO_FROM_EMAIL=

# Public site URL, used for metadata and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
